generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  name        String?
  passwordHash String?
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  avatarUrl   String?
  role        UserRole        @default(USER)
  locale      String          @default("ru")
  status      UserStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessions    Session[]
  analyses    Analysis[]
  payments    Payment[]
  events      AnalyticsEvent[]
  adminEvents AdminAuditLog[] @relation("AdminAuditActor")
  habitPrograms HabitProgram[]
  habitThreads  HabitNavigatorThread[]
  telegramAccounts TelegramAccount[]
}

model LoginToken {
  id         String           @id @default(cuid())
  email      String
  tokenHash  String           @unique
  purpose    AuthTokenPurpose @default(MAGIC_LOGIN)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email, expiresAt])
}

model Session {
  id         String           @id @default(cuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  guestToken String           @unique
  locale     String           @default("ru")
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  analyses   Analysis[]
  events     AnalyticsEvent[]
  habitPrograms HabitProgram[]
  habitThreads  HabitNavigatorThread[]
  telegramAccounts TelegramAccount[]
}

model Analysis {
  id            String          @id @default(cuid())
  sessionId     String
  session       Session         @relation(fields: [sessionId], references: [id])
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  locale        String          @default("ru")
  audioKey      String?
  photoKey      String?
  audioUrl      String?
  photoUrl      String?
  ikigaiAnswers Json?
  jobId         String?
  status        AnalysisStatus  @default(PENDING)
  errorMessage  String?
  retryCount    Int             @default(0)
  reportFree    Json?
  reportFull    Json?
  reportVersion Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?
  payment       Payment?
  mediaAssets   MediaAsset[]
  reports       Report[]
  jobEvents     JobEvent[]
  events        AnalyticsEvent[]
  habitPrograms HabitProgram[]
}

model Payment {
  id                    String        @id @default(cuid())
  analysisId            String        @unique
  analysis              Analysis      @relation(fields: [analysisId], references: [id])
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  promoCodeId           String?
  promoCode             PromoCode?    @relation(fields: [promoCodeId], references: [id])
  stripePaymentIntentId String        @unique
  stripeCheckoutSessionId String?     @unique
  stripeCustomerId      String?
  originalAmount        Int?
  discountAmount        Int           @default(0)
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  paidAt                DateTime?
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  description    String?
  discountType   PromoDiscountType
  percentOff     Int?
  amountOff      Int?
  currency       String?
  active         Boolean           @default(true)
  maxRedemptions Int?
  redemptions    Int               @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payments       Payment[]

  @@index([active, expiresAt])
}

model MediaAsset {
  id         String           @id @default(cuid())
  analysisId String
  analysis   Analysis         @relation(fields: [analysisId], references: [id])
  type       MediaAssetType
  key        String           @unique
  mimeType   String
  size       Int?
  checksum   String?
  status     MediaAssetStatus @default(CREATED)
  createdAt  DateTime         @default(now())
  uploadedAt DateTime?
  verifiedAt DateTime?
}

model Report {
  id            String     @id @default(cuid())
  analysisId    String
  analysis      Analysis   @relation(fields: [analysisId], references: [id])
  tier          ReportTier
  language      String     @default("ru")
  promptVersion Int        @default(1)
  model         String?
  output        Json
  createdAt     DateTime   @default(now())

  @@unique([analysisId, tier, language])
}

model PromptTemplate {
  id          String       @id @default(cuid())
  key         String
  locale      String       @default("ru")
  version     Int          @default(1)
  status      PromptStatus @default(DRAFT)
  title       String
  content     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@unique([key, locale, version])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  name       String
  locale     String    @default("ru")
  properties Json?
  sessionId  String?
  session    Session?  @relation(fields: [sessionId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([name, createdAt])
  @@index([analysisId])
}

model JobEvent {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id])
  status     String?
  progress   Int
  stage      String?
  log        String?
  createdAt  DateTime @default(now())

  @@index([analysisId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation("AdminAuditActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

model FounderIntakeItem {
  id                  String   @id
  type                String
  title               String
  source              String
  decision            String
  priority            String   @default("NORMAL")
  queueStatus         String   @default("NOT_QUEUED")
  codexStatus         String   @default("NEW")
  bridgeStatus        String   @default("NOT_CONFIGURED")
  bridgeAttempts      Int      @default(0)
  bridgeLastError     String?
  bridgeDeliveredAt   DateTime?
  bridgeRespondedAt   DateTime?
  codexReply          String?
  summary             String
  sanitizedBody       String
  answer              String?
  allowedWork         Json
  risks               Json
  blockedReasons      Json
  requiredChecks      Json
  howToMakeWorkable   Json
  clarifyingQuestions Json
  rawAudit            Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([decision, queueStatus, createdAt])
  @@index([priority, createdAt])
  @@index([codexStatus, createdAt])
  @@index([bridgeStatus, createdAt])
}

model HabitDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  cycle       Int      @default(1)
  week        Int      @default(1)
  title       String
  focus       String
  essence     String
  practice    String
  why         String
  book        String?
  zone        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enrollments HabitEnrollment[]

  @@index([active, cycle, week])
}

model HabitProgram {
  id          String             @id @default(cuid())
  userId      String?
  user        User?              @relation(fields: [userId], references: [id])
  sessionId   String?
  session     Session?           @relation(fields: [sessionId], references: [id])
  analysisId  String?
  analysis    Analysis?          @relation(fields: [analysisId], references: [id])
  status      HabitProgramStatus @default(ACTIVE)
  source      String             @default("manual")
  title       String
  weakZone    String?
  archetype   String?
  topRole     String?
  careerAction String?
  finalInsight String?
  profile     Json?
  currentCycle Int              @default(1)
  currentWeek  Int              @default(1)
  reminderEnabled Boolean       @default(true)
  reminderTime String           @default("09:00")
  weeklyFreezes Int             @default(1)
  trialStartedAt DateTime?
  trialEndsAt DateTime?
  subscriptionStatus String     @default("TRIAL")
  startedAt   DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments HabitEnrollment[]
  checkins    HabitCheckin[]
  insights    HabitInsight[]
  dailyMetrics HabitDailyMetric[]
  rewards     HabitRewardEvent[]
  dailyTasks  HabitDailyTask[]
  weekSummaries HabitWeekSummary[]
  navigatorThreads HabitNavigatorThread[]
  notificationPreference HabitNotificationPreference?

  @@index([userId, status, createdAt])
  @@index([sessionId, status, createdAt])
  @@index([analysisId])
  @@index([status, currentCycle, currentWeek])
}

model HabitEnrollment {
  id                 String                @id @default(cuid())
  programId          String
  program            HabitProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  habitDefinitionId  String?
  habitDefinition    HabitDefinition?      @relation(fields: [habitDefinitionId], references: [id])
  title              String
  focus              String
  essence            String
  practice           String
  why                String
  book               String?
  zone               String?
  week               Int                   @default(1)
  sortOrder          Int                   @default(1)
  status             HabitEnrollmentStatus @default(ACTIVE)
  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  checkins           HabitCheckin[]
  insights           HabitInsight[]
  dailyTasks         HabitDailyTask[]
  weekSummaries      HabitWeekSummary[]

  @@index([programId, status, sortOrder])
}

model HabitCheckin {
  id           String          @id @default(cuid())
  programId    String
  program      HabitProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   HabitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime
  completed    Boolean         @default(true)
  note         String?
  energy       Int?
  clarity      Int?
  stability    Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([enrollmentId, date])
  @@index([programId, date])
}

model HabitInsight {
  id           String           @id @default(cuid())
  programId    String
  program      HabitProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   HabitEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  text         String
  source       String           @default("user")
  createdAt    DateTime         @default(now())

  @@index([programId, createdAt])
}

model HabitDailyMetric {
  id        String       @id @default(cuid())
  programId String
  program   HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  date      DateTime
  energy    Int
  clarity   Int
  stability Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([programId, date])
  @@index([programId, date])
}

model HabitRewardEvent {
  id        String       @id @default(cuid())
  programId String
  program   HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  type      String
  label     String
  xp        Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([programId, createdAt])
}

model HabitDailyTask {
  id           String          @id @default(cuid())
  programId    String
  program      HabitProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   HabitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime?
  dayIndex     Int
  title        String
  taskText     String
  microAction  String
  whyToday     String
  completedAt  DateTime?
  xpAwarded    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([programId, enrollmentId, dayIndex])
  @@index([programId, date])
  @@index([enrollmentId, dayIndex])
}

model HabitWeekSummary {
  id             String          @id @default(cuid())
  programId      String
  program        HabitProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId   String
  enrollment     HabitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  cycle          Int
  week           Int
  checkinsDone   Int
  completionMode String
  summary        String
  pingviFeedback String
  rewardLabel    String
  xpAwarded      Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([programId, enrollmentId])
  @@index([programId, createdAt])
}

model HabitNavigatorThread {
  id        String       @id @default(cuid())
  programId String?
  program   HabitProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  sessionId String?
  session   Session?     @relation(fields: [sessionId], references: [id])
  title     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  HabitNavigatorMessage[]

  @@index([programId, updatedAt])
  @@index([userId, updatedAt])
  @@index([sessionId, updatedAt])
}

model HabitNavigatorMessage {
  id        String               @id @default(cuid())
  threadId  String
  thread    HabitNavigatorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  text      String
  model     String?
  channel   String               @default("WEB")
  createdAt DateTime             @default(now())

  @@index([threadId, createdAt])
  @@index([channel, createdAt])
}

model TelegramAccount {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  sessionId      String?
  session        Session?  @relation(fields: [sessionId], references: [id])
  telegramUserId String    @unique
  chatId         String
  username       String?
  firstName      String?
  lastName       String?
  status         String    @default("ACTIVE")
  linkedAt       DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@index([sessionId, updatedAt])
  @@index([chatId])
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String?
  sessionId  String?
  programId  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([userId, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([programId, expiresAt])
}

model TelegramWebLoginToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  telegramUserId String
  userId         String?
  sessionId      String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?

  @@index([telegramUserId, expiresAt])
  @@index([sessionId, expiresAt])
}

model HabitNotificationPreference {
  id                  String       @id @default(cuid())
  programId           String       @unique
  program             HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  telegramEnabled     Boolean      @default(false)
  reminderTime        String       @default("09:00")
  timezone            String       @default("Europe/Moscow")
  quietHoursStart     String?
  quietHoursEnd       String?
  motivationFrequency String       @default("daily")
  lastReminderAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([telegramEnabled, reminderTime])
}

enum AnalysisStatus {
  PENDING
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PromoDiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MediaAssetType {
  AUDIO
  PHOTO
}

enum MediaAssetStatus {
  CREATED
  UPLOADED
  VERIFIED
  REJECTED
}

enum ReportTier {
  FREE
  FULL
}

enum PromptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AuthTokenPurpose {
  MAGIC_LOGIN
}

enum HabitProgramStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum HabitEnrollmentStatus {
  ACTIVE
  COMPLETED
  SKIPPED
  ARCHIVED
}
