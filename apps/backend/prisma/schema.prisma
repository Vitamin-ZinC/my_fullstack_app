generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  name        String?
  passwordHash String?
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  avatarUrl   String?
  role        UserRole        @default(USER)
  locale      String          @default("ru")
  status      UserStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessions    Session[]
  analyses    Analysis[]
  payments    Payment[]
  events      AnalyticsEvent[]
  adminEvents AdminAuditLog[] @relation("AdminAuditActor")
  habitPrograms HabitProgram[]
  habitThreads  HabitNavigatorThread[]
  telegramAccounts TelegramAccount[]
  partnerAttribution PartnerAttribution?
  partnerEvents PartnerEvent[]
  partnerOfferRedemptions PartnerOfferRedemption[]
  walletTransactions InternalWalletTransaction[]
  coachRelationships CoachClientRelationship[]
  coachServiceOrders CoachServiceOrder[]
  coachMessages CoachMessage[] @relation("CoachMessageUser")
  coachAssignments CoachAssignment[] @relation("CoachAssignmentUser")
  coachRewardRedemptions CoachRewardRedemption[]
  coachAppointments CoachAppointment[]
}

model LoginToken {
  id         String           @id @default(cuid())
  email      String
  tokenHash  String           @unique
  purpose    AuthTokenPurpose @default(MAGIC_LOGIN)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email, expiresAt])
}

model Session {
  id         String           @id @default(cuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  guestToken String           @unique
  locale     String           @default("ru")
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  analyses   Analysis[]
  events     AnalyticsEvent[]
  habitPrograms HabitProgram[]
  habitThreads  HabitNavigatorThread[]
  telegramAccounts TelegramAccount[]
  partnerOfferRedemptions PartnerOfferRedemption[]
  walletTransactions InternalWalletTransaction[]
}

model Analysis {
  id            String          @id @default(cuid())
  sessionId     String
  session       Session         @relation(fields: [sessionId], references: [id])
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  locale        String          @default("ru")
  audioKey      String?
  photoKey      String?
  audioUrl      String?
  photoUrl      String?
  ikigaiAnswers Json?
  jobId         String?
  status        AnalysisStatus  @default(PENDING)
  errorMessage  String?
  retryCount    Int             @default(0)
  reportFree    Json?
  reportFull    Json?
  reportVersion Int             @default(1)
  audioConsentAt DateTime?
  faceConsentAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?
  payment       Payment?
  mediaAssets   MediaAsset[]
  reports       Report[]
  jobEvents     JobEvent[]
  events        AnalyticsEvent[]
  habitPrograms HabitProgram[]
}

model Payment {
  id                    String        @id @default(cuid())
  analysisId            String        @unique
  analysis              Analysis      @relation(fields: [analysisId], references: [id])
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  promoCodeId           String?
  promoCode             PromoCode?    @relation(fields: [promoCodeId], references: [id])
  stripePaymentIntentId String        @unique
  stripeCheckoutSessionId String?     @unique
  stripeCustomerId      String?
  originalAmount        Int?
  discountAmount        Int           @default(0)
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  paidAt                DateTime?
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  description    String?
  discountType   PromoDiscountType
  percentOff     Int?
  amountOff      Int?
  currency       String?
  active         Boolean           @default(true)
  maxRedemptions Int?
  redemptions    Int               @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payments       Payment[]

  @@index([active, expiresAt])
}

model MediaAsset {
  id         String           @id @default(cuid())
  analysisId String
  analysis   Analysis         @relation(fields: [analysisId], references: [id])
  type       MediaAssetType
  key        String           @unique
  mimeType   String
  size       Int?
  checksum   String?
  status     MediaAssetStatus @default(CREATED)
  createdAt  DateTime         @default(now())
  uploadedAt DateTime?
  verifiedAt DateTime?
}

model Report {
  id            String     @id @default(cuid())
  analysisId    String
  analysis      Analysis   @relation(fields: [analysisId], references: [id])
  tier          ReportTier
  language      String     @default("ru")
  promptVersion Int        @default(1)
  model         String?
  output        Json
  createdAt     DateTime   @default(now())

  @@unique([analysisId, tier, language])
}

model PromptTemplate {
  id          String       @id @default(cuid())
  key         String
  locale      String       @default("ru")
  version     Int          @default(1)
  status      PromptStatus @default(DRAFT)
  title       String
  content     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@unique([key, locale, version])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model CoachPartnershipLead {
  id                      String                     @id @default(cuid())
  idempotencyKey          String                     @unique
  fullName                String
  email                   String
  telegram                String?
  city                    String?
  practiceFormat          String
  experienceYears         Int?
  activeClients           Int?
  interests               Json
  message                 String?
  source                  String                     @default("coaches_landing")
  status                  CoachPartnershipLeadStatus @default(NEW)
  consentAt               DateTime
  materialTokenHash       String                     @unique
  materialExpiresAt       DateTime
  materialOpenedAt        DateTime?
  applicantEmailStatus    String                     @default("PENDING")
  teamNotificationStatus  String                     @default("PENDING")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model CoachProfile {
  id                   String             @id @default(cuid())
  partnerCorePartnerId String             @unique
  partnerCorePayoutReferralCode String?
  referredByReferralCode String?
  slug                 String             @unique
  displayName          String
  headline             String?
  bio                  String?
  city                 String?
  specializations      Json?
  languages            Json?
  avatarUrl            String?
  coverImageUrl        String?
  status               CoachProfileStatus @default(DRAFT)
  acceptingOrders      Boolean            @default(false)
  featured             Boolean            @default(false)
  moderationNote       String?
  publicSince          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  planOverrides        CoachPriceOverride[]
  subscriptions        CoachSubscription[]
  invites              CoachClientInvite[]
  clients              CoachClientRelationship[]
  serviceOffers        CoachServiceOffer[]
  messages             CoachMessage[]
  assignments          CoachAssignment[]
  habitAssignments     CoachHabitAssignment[]
  sites                CoachSite[]
  calendlyConnection   CoachCalendlyConnection?
  googleCalendarConnection CoachGoogleCalendarConnection?
  scheduleSettings     CoachScheduleSettings?
  appointments         CoachAppointment[]
  rewards              CoachReward[]

  @@index([status, acceptingOrders, featured])
}

model CoachPlan {
  id              String                  @id @default(cuid())
  code            String                  @unique
  stripeProductId String?                 @unique
  name            String
  description     String?
  includedClients Int?
  customQuote     Boolean                 @default(false)
  active          Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  priceVersions   CoachPlanPriceVersion[]
  overrides       CoachPriceOverride[]
  subscriptions   CoachSubscription[]
}

model CoachPlanPriceVersion {
  id            String                  @id @default(cuid())
  planId        String
  plan          CoachPlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount        Int
  currency      String                  @default("usd")
  stripePriceId String?                 @unique
  effectiveFrom DateTime                @default(now())
  effectiveTo   DateTime?
  migrationMode CoachPriceMigrationMode @default(NEW_ONLY)
  active        Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  subscriptions CoachSubscription[]

  @@index([planId, active, effectiveFrom])
}

model CoachPriceOverride {
  id             String       @id @default(cuid())
  coachProfileId String
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  planId         String
  plan           CoachPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  amount         Int
  currency       String       @default("usd")
  active         Boolean      @default(true)
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([coachProfileId, planId, active])
}

model CoachSubscription {
  id                          String                  @id @default(cuid())
  coachProfileId              String
  coachProfile                CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  planId                      String
  plan                        CoachPlan               @relation(fields: [planId], references: [id])
  priceVersionId              String?
  priceVersion                CoachPlanPriceVersion?  @relation(fields: [priceVersionId], references: [id])
  status                      CoachSubscriptionStatus @default(PENDING)
  amount                      Int
  currency                    String                  @default("usd")
  clientLimit                 Int?
  stripeCustomerId            String?
  stripeSubscriptionId        String?                 @unique
  stripeCheckoutSessionId     String?                 @unique
  currentPeriodStart          DateTime?
  currentPeriodEnd            DateTime?
  graceEndsAt                 DateTime?
  cancelAtPeriodEnd           Boolean                 @default(false)
  idempotencyKey              String                  @unique
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@index([coachProfileId, status, currentPeriodEnd])
}

model CoachClientInvite {
  id                String             @id @default(cuid())
  coachProfileId    String
  coachProfile      CoachProfile       @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  email             String?
  tokenHash         String             @unique
  funding           CoachClientFunding @default(COACH_PAID)
  metricsConsent    Boolean            @default(true)
  journalConsent    Boolean            @default(false)
  expiresAt         DateTime
  acceptedAt        DateTime?
  relationshipId    String?            @unique
  relationship      CoachClientRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())

  @@index([coachProfileId, expiresAt])
}

model CoachClientRelationship {
  id                String                  @id @default(cuid())
  coachProfileId    String
  coachProfile      CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  userId            String
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitProgramId    String?
  habitProgram      HabitProgram?           @relation(fields: [habitProgramId], references: [id], onDelete: SetNull)
  funding           CoachClientFunding      @default(COACH_PAID)
  status            CoachRelationshipStatus @default(PENDING)
  metricsConsentAt  DateTime?
  journalConsentAt  DateTime?
  consentRevokedAt  DateTime?
  startedAt         DateTime?
  accessEndsAt      DateTime?
  endedAt           DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  invites           CoachClientInvite[]
  serviceOrders     CoachServiceOrder[]
  messages          CoachMessage[]
  assignments       CoachAssignment[]
  habitAssignments  CoachHabitAssignment[]
  rewardRedemptions CoachRewardRedemption[]

  @@index([coachProfileId, status, funding])
  @@index([userId, status])
  @@index([habitProgramId])
}

model CoachServiceOffer {
  id                   String                  @id @default(cuid())
  coachProfileId       String
  coachProfile         CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  type                 CoachServiceType
  paymentModel         CoachServicePaymentModel @default(CLIENT_PAID)
  title                String
  description          String
  amount               Int
  currency             String                  @default("usd")
  coachShareBps        Int?
  platformShareBps     Int?
  calendlyEventTypeUri String?
  calendlySchedulingUrl String?
  status               CoachOfferStatus        @default(DRAFT)
  moderationNote       String?
  publishedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  orders               CoachServiceOrder[]

  @@index([coachProfileId, status, type])
}

model CoachServiceOrder {
  id                      String                  @id @default(cuid())
  offerId                 String
  offer                   CoachServiceOffer       @relation(fields: [offerId], references: [id])
  userId                  String
  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipId          String?
  relationship            CoachClientRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  status                  CoachServiceOrderStatus @default(PENDING_PAYMENT)
  amount                  Int
  currency                String                  @default("usd")
  coachShareBpsSnapshot   Int
  platformShareBpsSnapshot Int
  stripeCheckoutSessionId String?                 @unique
  stripePaymentIntentId   String?                 @unique
  stripeSubscriptionId    String?                 @unique
  calendlyEventUri        String?
  calendlyInviteeUri      String?
  scheduledFor            DateTime?
  bookingDeadline         DateTime?
  bookedAt                DateTime?
  cancelledAt             DateTime?
  refundRequestedAt       DateTime?
  refundAmount            Int?
  refundedAt              DateTime?
  idempotencyKey          String                  @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  appointment             CoachAppointment?

  @@index([userId, status, createdAt])
  @@index([offerId, status, createdAt])
  @@index([bookingDeadline, status])
}

model CoachMessage {
  id                         String                  @id @default(cuid())
  relationshipId             String
  relationship               CoachClientRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  coachProfileId             String
  coachProfile               CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User                    @relation("CoachMessageUser", fields: [userId], references: [id], onDelete: Cascade)
  authorRole                 CoachMessageAuthorRole
  text                       String
  readAt                     DateTime?
  createdAt                  DateTime                @default(now())

  @@index([relationshipId, createdAt])
}

model CoachAssignment {
  id                         String                  @id @default(cuid())
  relationshipId             String
  relationship               CoachClientRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  coachProfileId             String
  coachProfile               CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  userId                     String
  user                       User                    @relation("CoachAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  title                      String
  details                    String
  dueAt                      DateTime?
  status                     CoachAssignmentStatus   @default(OPEN)
  completedAt                DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([relationshipId, status, dueAt])
}

model CoachHabitAssignment {
  id                         String                  @id @default(cuid())
  relationshipId             String
  relationship               CoachClientRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  coachProfileId             String
  coachProfile               CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  habitDefinitionId          String?
  habitDefinition            HabitDefinition?        @relation(fields: [habitDefinitionId], references: [id], onDelete: SetNull)
  enrollmentId               String?
  enrollment                 HabitEnrollment?        @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  title                      String
  focus                      String
  practice                   String
  why                        String
  startsAt                   DateTime                @default(now())
  endsAt                     DateTime?
  status                     CoachHabitAssignmentStatus @default(PROPOSED)
  clientAcceptedAt           DateTime?
  clientDeclinedAt           DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@index([relationshipId, status, startsAt])
}

model CoachSitePlan {
  id                   String      @id @default(cuid())
  code                 String      @unique
  name                 String
  setupAmount          Int
  monthlySupportAmount Int
  currency             String      @default("usd")
  features             Json?
  active               Boolean     @default(true)
  sortOrder            Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  sites                CoachSite[]
}

model CoachSite {
  id                       String          @id @default(cuid())
  coachProfileId           String
  coachProfile             CoachProfile    @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  planId                   String
  plan                     CoachSitePlan   @relation(fields: [planId], references: [id])
  slug                     String          @unique
  customDomain             String?         @unique
  customDomainVerificationTokenHash String?
  customDomainStatus       CoachDomainStatus @default(NOT_CONFIGURED)
  status                   CoachSiteStatus @default(DRAFT)
  content                  Json?
  theme                    Json?
  stripeCheckoutSessionId  String?         @unique
  stripeSubscriptionId     String?         @unique
  supportCurrentPeriodEnd  DateTime?
  graceEndsAt              DateTime?
  publishedAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([coachProfileId, status])
}

model CoachCalendlyConnection {
  id                       String       @id @default(cuid())
  coachProfileId           String       @unique
  coachProfile             CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  accessTokenCiphertext    String
  refreshTokenCiphertext   String?
  tokenExpiresAt           DateTime?
  calendlyUserUri          String?
  calendlyOrganizationUri  String?
  webhookSubscriptionUri   String?
  scopes                   Json?
  status                   CoachIntegrationStatus @default(ACTIVE)
  lastSyncedAt             DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

model CoachGoogleCalendarConnection {
  id                     String                 @id @default(cuid())
  coachProfileId         String                 @unique
  coachProfile           CoachProfile           @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  tokenExpiresAt         DateTime?
  calendarId             String                 @default("primary")
  calendarName           String?
  scopes                 Json?
  status                 CoachIntegrationStatus @default(ACTIVE)
  lastSyncedAt           DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model CoachScheduleSettings {
  id                    String                  @id @default(cuid())
  coachProfileId        String                  @unique
  coachProfile          CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  provider              CoachSchedulingProvider @default(ORKEN)
  timezone              String                  @default("Europe/Moscow")
  slotDurationMinutes   Int                     @default(60)
  bufferBeforeMinutes   Int                     @default(0)
  bufferAfterMinutes    Int                     @default(15)
  minNoticeMinutes      Int                     @default(720)
  bookingHorizonDays    Int                     @default(30)
  active                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  availabilityRules     CoachAvailabilityRule[]
  availabilityExceptions CoachAvailabilityException[]
}

model CoachAvailabilityRule {
  id             String                @id @default(cuid())
  settingsId     String
  settings       CoachScheduleSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  weekday        Int
  startMinute    Int
  endMinute      Int
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([settingsId, weekday, active])
}

model CoachAvailabilityException {
  id             String                @id @default(cuid())
  settingsId     String
  settings       CoachScheduleSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  date           DateTime              @db.Date
  isAvailable    Boolean               @default(false)
  startMinute    Int?
  endMinute      Int?
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([settingsId, date])
}

model CoachAppointment {
  id              String                  @id @default(cuid())
  orderId         String                  @unique
  order           CoachServiceOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coachProfileId  String
  coachProfile    CoachProfile            @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  userId          String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt         DateTime
  endsAt           DateTime
  timezone         String
  provider         CoachSchedulingProvider
  status           CoachAppointmentStatus  @default(CONFIRMED)
  externalEventId  String?
  externalEventUrl String?
  meetingUrl       String?
  syncError        String?
  cancelledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([coachProfileId, startsAt, status])
  @@index([userId, startsAt, status])
}

model CoachReward {
  id               String            @id @default(cuid())
  coachProfileId   String
  coachProfile     CoachProfile      @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String
  pointsCost       Int
  entitlementType  String            @default("manual")
  entitlementValue String?
  status           CoachRewardStatus @default(DRAFT)
  moderationNote   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  redemptions      CoachRewardRedemption[]

  @@index([coachProfileId, status])
}

model CoachRewardRedemption {
  id                  String                  @id @default(cuid())
  rewardId            String
  reward              CoachReward             @relation(fields: [rewardId], references: [id])
  relationshipId      String
  relationship        CoachClientRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  userId              String
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsCost          Int
  walletTransactionId String                  @unique
  status              CoachRewardRedemptionStatus @default(FULFILLED)
  createdAt           DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([rewardId, createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  name       String
  locale     String    @default("ru")
  properties Json?
  sessionId  String?
  session    Session?  @relation(fields: [sessionId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([name, createdAt])
  @@index([analysisId])
}

model JobEvent {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id])
  status     String?
  progress   Int
  stage      String?
  log        String?
  createdAt  DateTime @default(now())

  @@index([analysisId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation("AdminAuditActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

model FounderIntakeItem {
  id                  String   @id
  type                String
  title               String
  source              String
  decision            String
  priority            String   @default("NORMAL")
  queueStatus         String   @default("NOT_QUEUED")
  codexStatus         String   @default("NEW")
  bridgeStatus        String   @default("NOT_CONFIGURED")
  bridgeAttempts      Int      @default(0)
  bridgeLastError     String?
  bridgeDeliveredAt   DateTime?
  bridgeRespondedAt   DateTime?
  codexReply          String?
  summary             String
  sanitizedBody       String
  answer              String?
  allowedWork         Json
  risks               Json
  blockedReasons      Json
  requiredChecks      Json
  howToMakeWorkable   Json
  clarifyingQuestions Json
  rawAudit            Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([decision, queueStatus, createdAt])
  @@index([priority, createdAt])
  @@index([codexStatus, createdAt])
  @@index([bridgeStatus, createdAt])
}

model HabitDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  cycle       Int      @default(1)
  week        Int      @default(1)
  title       String
  focus       String
  essence     String
  practice    String
  why         String
  book        String?
  zone        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
