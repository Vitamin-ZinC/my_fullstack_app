generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String          @id @default(cuid())
  email       String          @unique
  name        String?
  passwordHash String?
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  avatarUrl   String?
  role        UserRole        @default(USER)
  locale      String          @default("ru")
  status      UserStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  sessions    Session[]
  analyses    Analysis[]
  payments    Payment[]
  events      AnalyticsEvent[]
  adminEvents AdminAuditLog[] @relation("AdminAuditActor")
  habitPrograms HabitProgram[]
  habitThreads  HabitNavigatorThread[]
  telegramAccounts TelegramAccount[]
  partnerAttribution PartnerAttribution?
  partnerEvents PartnerEvent[]
  partnerOfferRedemptions PartnerOfferRedemption[]
  walletTransactions InternalWalletTransaction[]
}

model LoginToken {
  id         String           @id @default(cuid())
  email      String
  tokenHash  String           @unique
  purpose    AuthTokenPurpose @default(MAGIC_LOGIN)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email, expiresAt])
}

model Session {
  id         String           @id @default(cuid())
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])
  guestToken String           @unique
  locale     String           @default("ru")
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime         @default(now())
  expiresAt  DateTime
  analyses   Analysis[]
  events     AnalyticsEvent[]
  habitPrograms HabitProgram[]
  habitThreads  HabitNavigatorThread[]
  telegramAccounts TelegramAccount[]
  partnerOfferRedemptions PartnerOfferRedemption[]
  walletTransactions InternalWalletTransaction[]
}

model Analysis {
  id            String          @id @default(cuid())
  sessionId     String
  session       Session         @relation(fields: [sessionId], references: [id])
  userId        String?
  user          User?           @relation(fields: [userId], references: [id])
  locale        String          @default("ru")
  audioKey      String?
  photoKey      String?
  audioUrl      String?
  photoUrl      String?
  ikigaiAnswers Json?
  jobId         String?
  status        AnalysisStatus  @default(PENDING)
  errorMessage  String?
  retryCount    Int             @default(0)
  reportFree    Json?
  reportFull    Json?
  reportVersion Int             @default(1)
  audioConsentAt DateTime?
  faceConsentAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?
  payment       Payment?
  mediaAssets   MediaAsset[]
  reports       Report[]
  jobEvents     JobEvent[]
  events        AnalyticsEvent[]
  habitPrograms HabitProgram[]
}

model Payment {
  id                    String        @id @default(cuid())
  analysisId            String        @unique
  analysis              Analysis      @relation(fields: [analysisId], references: [id])
  userId                String?
  user                  User?         @relation(fields: [userId], references: [id])
  promoCodeId           String?
  promoCode             PromoCode?    @relation(fields: [promoCodeId], references: [id])
  stripePaymentIntentId String        @unique
  stripeCheckoutSessionId String?     @unique
  stripeCustomerId      String?
  originalAmount        Int?
  discountAmount        Int           @default(0)
  amount                Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())
  paidAt                DateTime?
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  description    String?
  discountType   PromoDiscountType
  percentOff     Int?
  amountOff      Int?
  currency       String?
  active         Boolean           @default(true)
  maxRedemptions Int?
  redemptions    Int               @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  payments       Payment[]

  @@index([active, expiresAt])
}

model MediaAsset {
  id         String           @id @default(cuid())
  analysisId String
  analysis   Analysis         @relation(fields: [analysisId], references: [id])
  type       MediaAssetType
  key        String           @unique
  mimeType   String
  size       Int?
  checksum   String?
  status     MediaAssetStatus @default(CREATED)
  createdAt  DateTime         @default(now())
  uploadedAt DateTime?
  verifiedAt DateTime?
}

model Report {
  id            String     @id @default(cuid())
  analysisId    String
  analysis      Analysis   @relation(fields: [analysisId], references: [id])
  tier          ReportTier
  language      String     @default("ru")
  promptVersion Int        @default(1)
  model         String?
  output        Json
  createdAt     DateTime   @default(now())

  @@unique([analysisId, tier, language])
}

model PromptTemplate {
  id          String       @id @default(cuid())
  key         String
  locale      String       @default("ru")
  version     Int          @default(1)
  status      PromptStatus @default(DRAFT)
  title       String
  content     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@unique([key, locale, version])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model CoachPartnershipLead {
  id                      String                     @id @default(cuid())
  idempotencyKey          String                     @unique
  fullName                String
  email                   String
  telegram                String?
  city                    String?
  practiceFormat          String
  experienceYears         Int?
  activeClients           Int?
  interests               Json
  message                 String?
  source                  String                     @default("coaches_landing")
  status                  CoachPartnershipLeadStatus @default(NEW)
  consentAt               DateTime
  materialTokenHash       String                     @unique
  materialExpiresAt       DateTime
  materialOpenedAt        DateTime?
  applicantEmailStatus    String                     @default("PENDING")
  teamNotificationStatus  String                     @default("PENDING")
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  name       String
  locale     String    @default("ru")
  properties Json?
  sessionId  String?
  session    Session?  @relation(fields: [sessionId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  analysisId String?
  analysis   Analysis? @relation(fields: [analysisId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([name, createdAt])
  @@index([analysisId])
}

model JobEvent {
  id         String   @id @default(cuid())
  analysisId String
  analysis   Analysis @relation(fields: [analysisId], references: [id])
  status     String?
  progress   Int
  stage      String?
  log        String?
  createdAt  DateTime @default(now())

  @@index([analysisId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation("AdminAuditActor", fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

model FounderIntakeItem {
  id                  String   @id
  type                String
  title               String
  source              String
  decision            String
  priority            String   @default("NORMAL")
  queueStatus         String   @default("NOT_QUEUED")
  codexStatus         String   @default("NEW")
  bridgeStatus        String   @default("NOT_CONFIGURED")
  bridgeAttempts      Int      @default(0)
  bridgeLastError     String?
  bridgeDeliveredAt   DateTime?
  bridgeRespondedAt   DateTime?
  codexReply          String?
  summary             String
  sanitizedBody       String
  answer              String?
  allowedWork         Json
  risks               Json
  blockedReasons      Json
  requiredChecks      Json
  howToMakeWorkable   Json
  clarifyingQuestions Json
  rawAudit            Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([decision, queueStatus, createdAt])
  @@index([priority, createdAt])
  @@index([codexStatus, createdAt])
  @@index([bridgeStatus, createdAt])
}

model HabitDefinition {
  id          String   @id @default(cuid())
  slug        String   @unique
  cycle       Int      @default(1)
  week        Int      @default(1)
  title       String
  focus       String
  essence     String
  practice    String
  why         String
  book        String?
  zone        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enrollments HabitEnrollment[]

  @@index([active, cycle, week])
}

model HabitProgram {
  id          String             @id @default(cuid())
  userId      String?
  user        User?              @relation(fields: [userId], references: [id])
  sessionId   String?
  session     Session?           @relation(fields: [sessionId], references: [id])
  analysisId  String?
  analysis    Analysis?          @relation(fields: [analysisId], references: [id])
  status      HabitProgramStatus @default(ACTIVE)
  source      String             @default("manual")
  title       String
  weakZone    String?
  archetype   String?
  topRole     String?
  careerAction String?
  finalInsight String?
  profile     Json?
  currentCycle Int              @default(1)
  currentWeek  Int              @default(1)
  reminderEnabled Boolean       @default(true)
  reminderTime String           @default("09:00")
  weeklyFreezes Int             @default(1)
  trialStartedAt DateTime?
  trialEndsAt DateTime?
  subscriptionStatus String     @default("TRIAL")
  stripeSubscriptionId String?  @unique
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCancelAtPeriodEnd Boolean @default(false)
  currentRankProvisional String?
  guruStreakCount Int           @default(0)
  legendStatus Boolean          @default(false)
  startedAt   DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  enrollments HabitEnrollment[]
  checkins    HabitCheckin[]
  insights    HabitInsight[]
  dailyMetrics HabitDailyMetric[]
  rewards     HabitRewardEvent[]
  dailyTasks  HabitDailyTask[]
  calendarEvents HabitCalendarEvent[]
  weekSummaries HabitWeekSummary[]
  rankHistory HabitRankHistory[]
  navigatorThreads HabitNavigatorThread[]
  notificationPreference HabitNotificationPreference?
  partnerBonusAttributions PartnerAttribution[] @relation("PartnerBonusProgram")
  walletTransactions InternalWalletTransaction[]

  @@index([userId, status, createdAt])
  @@index([sessionId, status, createdAt])
  @@index([analysisId])
  @@index([status, currentCycle, currentWeek])
}

model PartnerAffiliateProgram {
  id                        String                  @id @default(cuid())
  partnerCoreProgramId      String?
  name                      String
  referralDestination       String
  customerBonusType         PartnerCustomerBonusType @default(NONE)
  customerBonusValue        Int?
  customerBonusEntitlement  String?
  commissionModel           PartnerCommissionModel  @default(PERCENT)
  commissionRateBps         Int?
  fixedPayoutCents          Int?
  commissionWindowType      PartnerCommissionWindow @default(FIRST_PAYMENT)
  commissionWindowMonths    Int?
  lockDays                  Int                     @default(0)
  status                    PartnerProgramStatus    @default(PAUSED)
  termsVersion              String                  @default("v1")
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  attributions              PartnerAttribution[]
  events                    PartnerEvent[]
  referralLinks             PartnerReferralLink[]
  offers                    PartnerOffer[]

  @@index([status, updatedAt])
  @@index([partnerCoreProgramId])
}

model PartnerReferralLink {
  id                   String                  @id @default(cuid())
  programConfigId      String
  programConfig        PartnerAffiliateProgram @relation(fields: [programConfigId], references: [id], onDelete: Cascade)
  channel              String
  referralCode         String?
  url                  String?
  partnerCoreLinkId    String?
  status               String                  @default("CREATED")
  idempotencyKey       String                  @unique
  rawResponse          Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([programConfigId, channel])
}

model PartnerAttribution {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  programConfigId       String?
  programConfig         PartnerAffiliateProgram? @relation(fields: [programConfigId], references: [id], onDelete: SetNull)
  partnerCoreProgramId  String?
  partnerCorePartnerId  String?
  referralCode          String
  customerBonusType     PartnerCustomerBonusType @default(NONE)
  customerBonusValue    Int?
  customerBonusEntitlement String?
  bonusStatus           PartnerBonusStatus      @default(PENDING)
  bonusAppliedAt        DateTime?
  bonusAppliedProgramId String?
  bonusAppliedProgram   HabitProgram?           @relation("PartnerBonusProgram", fields: [bonusAppliedProgramId], references: [id], onDelete: SetNull)
  signupEventStatus     PartnerEventStatus      @default(PENDING)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([referralCode, createdAt])
  @@index([partnerCoreProgramId])
  @@index([partnerCorePartnerId])
  @@index([bonusStatus, createdAt])
}

model PartnerPortalSession {
  id                    String   @id @default(cuid())
  tokenHash             String   @unique
  coreSessionCiphertext String
  partnerCorePartnerId  String
  partnerStatus         String
  displayName           String?
  accountName           String?
  email                 String?
  expiresAt             DateTime
  revokedAt             DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([partnerCorePartnerId, expiresAt])
  @@index([expiresAt])
}

model PartnerEvent {
  id               String                  @id @default(cuid())
  type             PartnerEventType
  idempotencyKey   String                  @unique
  programConfigId  String?
  programConfig    PartnerAffiliateProgram? @relation(fields: [programConfigId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentId        String?
  externalId       String
  status           PartnerEventStatus      @default(PENDING)
  request          Json
  response         Json?
  error            String?
  attempts         Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([type, status, createdAt])
  @@index([userId, createdAt])
  @@index([paymentId])
}

model PartnerOffer {
  id                   String                  @id @default(cuid())
  programConfigId      String?
  programConfig        PartnerAffiliateProgram? @relation(fields: [programConfigId], references: [id], onDelete: SetNull)
  partnerId            String?
  partnerCorePlacementId String?                @unique
  partnerCoreStatus    String?
  partnerCoreSyncedAt  DateTime?
  kind                 String                  @default("manual_deal")
  surface              String                  @default("rewards_tab")
  title                String
  description          String
  imageUrl             String?
  redemptionCurrency   String                  @default("orken_points")
  redemptionAmount     Int
  userBenefit          String
  partnerPayoutCents   Int                     @default(0)
  capPerMonth          Int?
  status               PartnerOfferStatus      @default(DRAFT)
  entitlementType      String                  @default("manual")
  entitlementValue     String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  redemptions          PartnerOfferRedemption[]

  @@index([status, updatedAt])
  @@index([programConfigId])
  @@index([partnerId])
}

model PartnerOfferRedemption {
  id                      String                  @id @default(cuid())
  offerId                 String
  offer                   PartnerOffer            @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId                  String?
  user                    User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId               String?
  session                 Session?                @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  costCurrency            String                  @default("orken_points")
  costAmount              Int
  status                  PartnerRedemptionStatus @default(PENDING)
  entitlementType         String?
  entitlementValue        String?
  partnerCoreRedemptionId String?
  partnerCoreResponse     Json?
  deliveryError           String?
  idempotencyKey          String                  @unique
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([offerId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}

model InternalWalletTransaction {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId      String?
  session        Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  programId      String?
  program        HabitProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  currency       String    @default("orken_points")
  amountDelta    Int
  reason         String
  sourceType     String
  sourceId       String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  @@index([userId, currency, createdAt])
  @@index([sessionId, currency, createdAt])
  @@index([programId, createdAt])
}

model HabitRankHistory {
  id             String       @id @default(cuid())
  programId      String
  program        HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  rankTitle      String
  rankLevel      Int
  monthXp        Int
  monthMaxXp     Int
  monthPercent   Int
  guruStreakCount Int        @default(0)
  legendStatus   Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([programId, year, month])
  @@index([programId, createdAt])
}

model HabitEnrollment {
  id                 String                @id @default(cuid())
  programId          String
  program            HabitProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  habitDefinitionId  String?
  habitDefinition    HabitDefinition?      @relation(fields: [habitDefinitionId], references: [id])
  title              String
  focus              String
  essence            String
  practice           String
  why                String
  book               String?
  zone               String?
  week               Int                   @default(1)
  sortOrder          Int                   @default(1)
  status             HabitEnrollmentStatus @default(ACTIVE)
  startedAt          DateTime              @default(now())
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  checkins           HabitCheckin[]
  insights           HabitInsight[]
  dailyTasks         HabitDailyTask[]
  calendarEvents     HabitCalendarEvent[]
  weekSummaries      HabitWeekSummary[]

  @@index([programId, status, sortOrder])
}

model HabitCheckin {
  id           String          @id @default(cuid())
  programId    String
  program      HabitProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   HabitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime
  completed    Boolean         @default(true)
  note         String?
  energy       Int?
  clarity      Int?
  stability    Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([enrollmentId, date])
  @@index([programId, date])
}

model HabitInsight {
  id           String           @id @default(cuid())
  programId    String
  program      HabitProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId String?
  enrollment   HabitEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  text         String
  source       String           @default("user")
  createdAt    DateTime         @default(now())

  @@index([programId, createdAt])
}

model HabitDailyMetric {
  id        String       @id @default(cuid())
  programId String
  program   HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  date      DateTime
  energy    Int
  clarity   Int
  stability Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([programId, date])
  @@index([programId, date])
}

model HabitRewardEvent {
  id        String       @id @default(cuid())
  programId String
  program   HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  type      String
  label     String
  xp        Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([programId, createdAt])
}

model HabitDailyTask {
  id           String          @id @default(cuid())
  programId    String
  program      HabitProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   HabitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime?
  dayIndex     Int
  title        String
  taskText     String
  microAction  String
  whyToday     String
  completedAt  DateTime?
  xpAwarded    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  calendarEvents HabitCalendarEvent[]

  @@unique([programId, enrollmentId, dayIndex])
  @@index([programId, date])
  @@index([enrollmentId, dayIndex])
}

model HabitCalendarEvent {
  id              String           @id @default(cuid())
  programId       String
  program         HabitProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId    String?
  enrollment      HabitEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  dailyTaskId     String?
  dailyTask       HabitDailyTask?  @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)
  title           String
  description     String
  startsAt        DateTime
  durationMinutes Int              @default(15)
  status          String           @default("SCHEDULED")
  source          String           @default("habit")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([programId, dailyTaskId])
  @@index([programId, startsAt])
  @@index([enrollmentId, startsAt])
}

model HabitWeekSummary {
  id             String          @id @default(cuid())
  programId      String
  program        HabitProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollmentId   String
  enrollment     HabitEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  cycle          Int
  week           Int
  checkinsDone   Int
  completionMode String
  summary        String
  pingviFeedback String
  rewardLabel    String
  xpAwarded      Int             @default(0)
  createdAt      DateTime        @default(now())

  @@unique([programId, enrollmentId])
  @@index([programId, createdAt])
}

model HabitNavigatorThread {
  id        String       @id @default(cuid())
  programId String?
  program   HabitProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  sessionId String?
  session   Session?     @relation(fields: [sessionId], references: [id])
  title     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  messages  HabitNavigatorMessage[]

  @@index([programId, updatedAt])
  @@index([userId, updatedAt])
  @@index([sessionId, updatedAt])
}

model HabitNavigatorMessage {
  id        String               @id @default(cuid())
  threadId  String
  thread    HabitNavigatorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  text      String
  model     String?
  channel   String               @default("WEB")
  createdAt DateTime             @default(now())

  @@index([threadId, createdAt])
  @@index([channel, createdAt])
}

model TelegramAccount {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  sessionId      String?
  session        Session?  @relation(fields: [sessionId], references: [id])
  telegramUserId String    @unique
  chatId         String
  username       String?
  firstName      String?
  lastName       String?
  status         String    @default("ACTIVE")
  linkedAt       DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@index([sessionId, updatedAt])
  @@index([chatId])
}

model TelegramCommunityChat {
  id                 String                       @id @default(cuid())
  telegramChatId     String                       @unique
  type               String
  title              String?
  username           String?
  status             TelegramCommunityChatStatus @default(PENDING)
  timezone           String                       @default("Europe/Moscow")
  schedulesEnabled   Boolean                      @default(false)
  aiRepliesEnabled   Boolean                      @default(true)
  smartPingEnabled   Boolean                      @default(false)
  morningTime        String                       @default("08:30")
  middayTime         String                       @default("13:30")
  eveningTime        String                       @default("21:00")
  quietHoursStart    String                       @default("22:00")
  quietHoursEnd      String                       @default("08:30")
  installedByUserId  String?
  lastHumanMessageAt DateTime?
  lastMorningAt      DateTime?
  lastMiddayAt       DateTime?
  lastEveningAt      DateTime?
  lastWakeAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  members            TelegramCommunityMember[]
  commitments        TelegramCommunityCommitment[]
  posts              TelegramCommunityPost[]

  @@index([status, schedulesEnabled])
  @@index([updatedAt])
}

model TelegramCommunityMember {
  id                  String                        @id @default(cuid())
  chatId              String
  chat                TelegramCommunityChat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  telegramUserId      String
  username            String?
  firstName           String?
  lastName            String?
  status              TelegramCommunityMemberStatus @default(ACTIVE)
  optedIn             Boolean                       @default(false)
  mentionEnabled      Boolean                       @default(false)
  points              Int                           @default(0)
  lastActivityAt      DateTime?
  lastCheckinAt       DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  commitments         TelegramCommunityCommitment[]

  @@unique([chatId, telegramUserId])
  @@index([chatId, optedIn, status])
  @@index([telegramUserId, updatedAt])
}

model TelegramCommunityCommitment {
  id            String                            @id @default(cuid())
  chatId        String
  chat          TelegramCommunityChat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  memberId      String
  member        TelegramCommunityMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dateKey       String
  text          String
  status        TelegramCommunityCommitmentStatus @default(PLANNED)
  pointsAwarded Int                               @default(0)
  completedAt   DateTime?
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt

  @@unique([chatId, memberId, dateKey])
  @@index([chatId, dateKey, status])
}

model TelegramCommunityPost {
  id                String                    @id @default(cuid())
  chatId            String
  chat              TelegramCommunityChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  dateKey           String
  type              TelegramCommunityPostType
  telegramMessageId String?
  sentAt            DateTime                  @default(now())

  @@unique([chatId, dateKey, type])
  @@index([chatId, sentAt])
}

model TelegramLinkToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String?
  sessionId  String?
  programId  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([userId, expiresAt])
  @@index([sessionId, expiresAt])
  @@index([programId, expiresAt])
}

model TelegramWebLoginToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  telegramUserId String
  userId         String?
  sessionId      String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?

  @@index([telegramUserId, expiresAt])
  @@index([sessionId, expiresAt])
}

model HabitNotificationPreference {
  id                  String       @id @default(cuid())
  programId           String       @unique
  program             HabitProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  telegramEnabled     Boolean      @default(false)
  reminderTime        String       @default("09:00")
  timezone            String       @default("Europe/Moscow")
  quietHoursStart     String?
  quietHoursEnd       String?
  motivationFrequency String       @default("daily")
  lastReminderAt      DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([telegramEnabled, reminderTime])
}

